{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufrn.br/musi/contratos/obra.schema.json",
  "title": "Obra",
  "versao": "1.1.0",
  "type": "object",
  "required": ["id", "titulo", "artista", "ano", "facetas"],
  "properties": {
    "id":      { "type": "string", "minLength": 1 },
    "titulo":  { "type": "string", "minLength": 1 },
    "artista": { "type": "string", "minLength": 1 },
    "ano":     { "type": "integer", "minimum": 1877, "maximum": 2100 },
    "facetas": { "type": "array", "items": { "$ref": "#/$defs/faceta" } },
    "mbid":           { "$ref": "#/$defs/mbid" },
    "mbidComposicao": { "$ref": "#/$defs/mbid" }
  },
  "additionalProperties": false,

  "$defs": {
    "mbid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "MusicBrainz ID (UUID). `mbid` é a gravação; `mbidComposicao` é a obra/composição. Preenchidos na conciliação, fora do ciclo de leitura — ADR-0003."
    },
    "faceta": {
      "type": "object",
      "required": ["dimensao", "valor"],
      "properties": {
        "dimensao": { "$ref": "#/$defs/termo" },
        "valor":    { "$ref": "#/$defs/termo" }
      },
      "additionalProperties": false
    },
    "termo": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Minúsculas, sem acento, com hífen. Ver docs/GLOSSARIO.md e ADR-0002."
    }
  }
}
